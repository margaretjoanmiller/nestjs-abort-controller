{
  "name": "nest-abort-controller",
  "version": "1.3.1",
  "description": "AbortController integration for NestJS: request-scoped cancellation using AbortSignal.",
  "keywords": [
    "abort",
    "abort-signal",
    "abortcontroller",
    "cancellation",
    "middleware",
    "nestjs",
    "request-cancellation",
    "typescript"
  ],
  "homepage": "https://github.com/ylcnfrht/nestjs-abort-controller#readme",
  "bugs": {
    "url": "https://github.com/ylcnfrht/nestjs-abort-controller/issues"
  },
  "license": "MIT",
  "author": "Ferhat Yalçın",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build",
    "start:example": "ts-node usage/src/main.ts"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "express": "^5.1.0",
    "jest": "^30.5.1",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
